# ===================================================================
# TALOVIN PRODUCTION ENVIRONMENT VARIABLES (.env)
# ===================================================================

# Database PostgreSQL
DB_NAME=talovin_db
DB_USER=talovin_user
DB_PASSWORD=talovin_secure_password_here

# Redis
REDIS_PASSWORD=talovin_redis_secure_password_here

# Security & JWT (HMAC-SHA256 >= 32 chars)
JWT_SECRET=talovin_jwt_secret_key_production_32_characters_long_min

# CORS Allowed Domains (comma-separated)
ALLOWED_ORIGINS=https://talovin.duckdns.org,https://chat-togetther.vercel.app,http://localhost:5173
